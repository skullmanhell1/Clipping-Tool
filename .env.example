# =============================================================================
# AI Video Clipper -- environment configuration
# Copy to `.env` and fill in the values you need. All keys are optional for
# booting the app; features that require a given key will be enabled in later
# phases as the keys are provided.
# =============================================================================

# --------------------------------- App ---------------------------------------
APP_NAME="AI Video Clipper"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list, or * for all. NOTE: while this is *, credentialed
# cross-origin requests are disabled — the CORS spec forbids combining a wildcard
# origin with Access-Control-Allow-Credentials and browsers reject the response.
# Set an explicit list (e.g. https://app.example.com) for a public deployment.
CORS_ORIGINS=*

# ------------------------------- Queue ---------------------------------------
REDIS_URL=redis://redis:6379/0
USE_INPROCESS_FALLBACK=true      # run jobs synchronously if Redis is down
RQ_QUEUE_NAME=clips

# --------------------------------- LLM ---------------------------------------
# Pluggable client -- choose one provider. Only the matching key is required.
# Without any key the app still works using the deterministic (non-AI) fallback.
LLM_PROVIDER=openai              # openai | anthropic | gemini

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                 # optional: e.g. http://localhost:11434/v1 (Ollama)

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini (free tier available) -- get a key at https://aistudio.google.com/apikey
# Set LLM_PROVIDER=gemini to use these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Google's OpenAI-compatible endpoint; no need to change.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------- Transcription ----------------------------------
# T1: "small" rather than "base". A mis-transcribed word is burned into the video, and
# "base" is a noticeable accuracy step down. Larger models are better and cost more.
WHISPER_MODEL=small              # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto              # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 | int8_float16 | float16 | float32

# T4: text prepended to the decode so Whisper has a reason to expect unusual words.
# Without it a recurring proper noun is mis-transcribed the same way every time it is
# said, and that mistake is burned into every clip's captions. This is the standing
# list for a channel that always says the same handful of unusual words; per-video
# terms belong in the job's own `vocabulary` field, which is appended after this.
WHISPER_INITIAL_PROMPT=

# T5: voice-activity detection. It was switched on with every parameter left at the
# library default, so none of it could be adjusted for difficult audio. These *are*
# faster-whisper's defaults, so behaviour is unchanged until one is changed on purpose.
#
# Lower the threshold to keep quiet or distant speech the default discards; raise it to
# reject more room noise. Raising MIN_SPEECH_MS drops short interjections -- "yeah", a
# laugh -- which on the wrong footage is the punchline. SPEECH_PAD_MS too low clips the
# first and last phoneme of every utterance.
#
# Note: all of these are part of the transcript cache key, so changing one re-transcribes
# rather than serving a transcript decoded under the old settings.
WHISPER_VAD_FILTER=true
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_MIN_SILENCE_MS=2000
WHISPER_VAD_MIN_SPEECH_MS=250
WHISPER_VAD_SPEECH_PAD_MS=400

# -------------------------------- Storage ------------------------------------
STORAGE_BACKEND=local            # local | s3  (same code path either way)
STORAGE_ROOT=./storage
UPLOADS_DIR=./storage/uploads
TEMP_DIR=./storage/temp
CLIPS_DIR=./storage/clips
# Default retention window (days) for finished clips; 0 = keep forever. This is
# the default only -- it is adjustable at runtime from the Storage settings UI
# (persisted to storage/runtime_config.json) alongside the toggles below.
RETENTION_DAYS=30
AUTO_DELETE_TEMP=true            # delete a job's temp/scratch files when it ends
DELETE_LOCAL_AFTER_PUBLISH=false # delete the local clip after a successful publish
RETENTION_SWEEP_HOURS=6          # background retention sweep interval
DISK_WARN_FREE_GB=2              # warn in the UI when free space drops below this
DISK_WARN_PERCENT=90             # warn in the UI when used space exceeds this %
# Computing the per-area sizes shown by /api/storage walks clips/, uploads/ and
# temp/ in full, and the storage panel polls that endpoint. The figures are a
# rough gauge, so they are cached briefly. 0 = always recompute.
DISK_USAGE_CACHE_SECONDS=30
# Durable job/clip records. Without this the job store is process memory only, so
# a restart loses every job and the history view lists clips whose download 404s.
JOBS_DB=./storage/jobs.db
# Upper bound on retained job records, so the table cannot grow without limit.
# 0 disables pruning.
MAX_PERSISTED_JOBS=500
# Where the runtime-tunable settings and saved publishing profiles are persisted.
RUNTIME_CONFIG_PATH=./storage/runtime_config.json
PROFILES_PATH=./storage/profiles.json

# ------------------------------- Uploads -------------------------------------
# Guard rails on /api/upload. Without a ceiling any client can fill the disk, and
# without an allow-list arbitrary files land in a directory later fed to ffmpeg.
MAX_UPLOAD_BYTES=2147483648      # 2 GiB; 0 = unlimited
UPLOAD_CHUNK_BYTES=1048576       # 1 MiB streaming chunk
ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi,.m4v,.mpg,.mpeg,.wmv,.flv,.ts,.m2ts,.3gp,.mp3,.wav,.m4a,.aac,.flac,.ogg

# ------------------------- S3 (optional, if STORAGE_BACKEND=s3) --------------
# Flip STORAGE_BACKEND=s3 to store clips durably in S3 (or an S3-compatible
# service). The rest of the app is unchanged.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                 # optional, for S3-compatible providers

# ------------------------------ Updates --------------------------------------
# "Check for updates" compares VERSION to the latest GitHub release.
GITHUB_REPO=skullmanhell1/Clipping-Tool
UPDATE_CHECK_ENABLED=true

# -------------------------------- FFmpeg -------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Wall-clock ceilings for media subprocesses. Jobs run in a single-worker thread
# pool, so an ffmpeg that hangs would otherwise block the whole queue forever with
# no error. Encoding gets a generous ceiling (a long source legitimately takes
# minutes); probing is metadata-only. Set either to 0 for no ceiling.
FFMPEG_TIMEOUT_SECONDS=3600
FFPROBE_TIMEOUT_SECONDS=60
# x264 quality and speed for every rendered clip. Lower CRF is better quality and a
# bigger file; 18-23 is the sane range. Presets trade encode speed for efficiency
# (ultrafast..veryslow). Output is always 8-bit yuv420p / High profile / level 4.0,
# which is what makes clips playable everywhere -- that is not configurable on purpose.
X264_CRF=20
X264_PRESET=veryfast

# S9: snap clip starts to shot boundaries so a clip does not open mid-shot. Detection uses
# ffmpeg's luma-based scene score over a narrow window near each boundary - it finds most hard
# cuts and misses ones between shots of similar brightness, which is why the shift is capped.
SCENE_SNAP_ENABLED=true
SCENE_SNAP_THRESHOLD=0.3
SCENE_SNAP_WINDOW_S=2.0
SCENE_SNAP_MAX_SHIFT_S=1.0
# O3: delivered clips are encoded at this constant frame rate. Variable-frame-rate sources
# (screen recordings, most phone footage) otherwise let burned captions drift against speech.
OUTPUT_FPS=30
# O4: a VBV ceiling for delivered clips. -crf alone sets a quality target with no bitrate
# limit, so a busy clip can balloon past a platform's file-size cap and be rejected.
OUTPUT_MAX_BITRATE_KBPS=12000
# AU8: neither was set anywhere, so output audio was whatever the source happened to be -
# 44.1 kHz mono from a phone, 48 kHz 5.1 from a camera.
OUTPUT_SAMPLE_RATE=48000
OUTPUT_CHANNELS=2
# AU1: loudness targets. A clip quieter than the platform's target is turned *up* on
# playback, lifting its noise floor along with the speech. Per-platform targets live in
# worker/effects/audio.py (YouTube -14, TikTok/Instagram -11); this is the fallback.
LOUDNESS_TARGET_LUFS=-14.0
LOUDNESS_TRUE_PEAK_DB=-1.0
# AU2: how hard the music bed is pushed down while someone is speaking. 1.0 disables
# ducking and restores the old flat mix, which either buries speech or is inaudible.
MUSIC_DUCK_RATIO=8.0
# AU3: a true-peak limiter at the end of the audio chain, at LOUDNESS_TRUE_PEAK_DB. Guards the
# paths where loudness normalisation does not run: a hot source plus a music bed sums past full
# scale (measured at +5.5 dBFS true peak without it).
TRUE_PEAK_LIMIT_ENABLED=true
# V10: filler removal joins kept segments sample-exactly, so each seam was a step in the
# waveform - the click you hear at every removed "um". 0 restores the hard cut.
FILLER_SEAM_FADE_MS=12

# -------------------------------- Assets -------------------------------------
EMOJI_ASSETS_DIR=./assets/emoji
# Bundled caption fonts, described by assets/fonts/fonts.json. Passed to libass as
# 'fontsdir', so captions render in the intended face even on a host with no fonts
# installed. Point this elsewhere only if you have registered those faces yourself.
FONT_ASSETS_DIR=./assets/fonts
# Optional: drop your own licensed mood tracks here as <mood>.mp3 (e.g.
# upbeat.mp3, chill.mp3). If absent, a copyright-free bed is synthesised.
MUSIC_DIR=./assets/music

# ----------------------------- Effects (P4) ----------------------------------
# The emoji the built-in keyword map can produce are committed under assets/emoji
# (Noto Emoji 512px, OFL-1.1, fetched by scripts/fetch_emoji.py), so rendering needs no
# network. This URL is only consulted for a glyph that is not vendored, and only when
# EMOJI_ALLOW_DOWNLOAD is turned on.
EMOJI_CDN_BASE=https://raw.githubusercontent.com/googlefonts/noto-emoji/main/png/512
EMOJI_ALLOW_DOWNLOAD=false
# Default background-music level (0..1) mixed under the original audio.
MUSIC_DEFAULT_VOLUME=0.12
# A15: the fallback "music" bed is not music - it is two sine tones with tremolo, identical
# for every clip of a given mood. Drop your own licensed tracks in MUSIC_DIR to get a real
# bed; set this to false to render silence instead of a drone when you have none. Clips that
# use the fallback are marked music_degraded:synthesised.
MUSIC_ALLOW_SYNTHESIS=true

# T8: ASR is the most expensive stage and the most repeated - re-running a source to try a
# different caption preset or aspect ratio re-transcribes audio that has not changed. The key
# covers the source's content hash *and* the ASR settings, so upgrading WHISPER_MODEL or
# re-exporting the footage misses the cache rather than serving a stale transcript.
# T3: Whisper invents text over music, applause and silence, and gets stuck in decode loops.
# Every threshold is set so two independent signals must agree before a segment is dropped: a
# false positive deletes real speech and nothing downstream can notice, while a missed
# hallucination is visible in the clip. NO_SPEECH and LOGPROB must coincide; neither acts alone.
TRANSCRIPT_FILTER_ENABLED=true
TRANSCRIPT_NO_SPEECH_THRESHOLD=0.6
TRANSCRIPT_LOGPROB_THRESHOLD=-1.0
TRANSCRIPT_MAX_TOKEN_RUN=4
TRANSCRIPT_MAX_SEGMENT_REPEATS=2
TRANSCRIPT_MIN_WORD_PROBABILITY=0.35
# Below this share of surviving segments nothing is dropped at all: if most of a transcript
# looks invented the thresholds are wrong for that audio, and emptying it is worse than
# keeping a poor transcript.
TRANSCRIPT_FILTER_KEEP_FLOOR=0.5

TRANSCRIPT_CACHE_DIR=./storage/transcripts
TRANSCRIPT_CACHE_ENABLED=true

# ------------------------------- B-roll --------------------------------------
# Local b-roll library and its cache. BROLL_PROVIDER is empty by default, which
# means local assets only -- no network. Set a provider plus its key to allow
# fetching, and BROLL_ALLOW_DOWNLOAD=true to permit the fetch itself.
BROLL_DIR=./assets/broll
BROLL_CACHE_DIR=./assets/broll_cache
BROLL_PROVIDER=
BROLL_PROVIDER_API_KEY=
BROLL_PROVIDER_BASE_URL=
BROLL_ALLOW_DOWNLOAD=false

# ---------------------------- Caption placement ------------------------------
# C12: platform UI safe areas. The caption margins were hard-coded at 220/200 and are not
# TikTok-aware, so a caption could sit under the username, the platform's own caption text
# or the action rail -- unreadable, and invisible to the creator because that chrome is not
# in the rendered file. Insets are fractions of frame height, so they hold at every
# OUTPUT_SHORT_SIDE. Empty selects the generic profile, which reproduces the previous
# margins exactly at 1080x1920 (200 top / 220 bottom / 80 side).
CAPTION_SAFE_AREA=              # tiktok | instagram | youtube | none  (empty = generic)
# C13: extra distance between the caption and its edge, in pixels. Positive only -- a
# negative value would push text into the chrome the safe area exists to avoid.
CAPTION_OFFSET_PX=0

# C22: mask profanity in burned captions, keeping the first letter and the word's length
# ("f******!") so the sentence stays readable. Off by default on purpose: burned captions
# are permanent, and a creator whose voice is profane should not be censored by their own
# tool. The list is deliberately short and matches whole words only, so "classic" and
# "Scunthorpe" are untouched -- a masked word inside an innocent one is far more
# conspicuous than an unmasked profanity, because the viewer can see the tool got it wrong.
CAPTION_MASK_PROFANITY=false

# ---------------------------- Clip selection ---------------------------------
# Visual selection samples this many keyframes per source and blends their
# brightness/motion cues with the transcript score. The weight is 0..1:
# 0 = transcript only, 1 = visuals only. Brightness and motion are weak signals
# for talking-head footage, where the transcript is the better guide.
#
# S14: the count was 12 and the width 160, at which the signal cannot do its job -
# 12 frames across an hour is one every five minutes, so every candidate in a
# five-minute stretch scored identically, and a 160px thumbnail averages away the
# frame-to-frame difference the motion proxy is meant to detect.
KEYFRAME_SAMPLE_LIMIT=48
KEYFRAME_SAMPLE_WIDTH=480
VISUAL_SELECTION_WEIGHT=0.5

# Per-signal weights for the deterministic fallback's ranking (S11, S17). They are
# relative and the scorer normalises by their total, so only the ratios matter.
# These replace the old rule of keeping the *longest* segments, which is worse than
# arbitrary: the longest silence-delimited segment is usually the stretch where
# nobody paused, and a punchy fifteen-second exchange lost to it every time.
#
# The defaults are a starting point, not a measured optimum. Tune them by running
# scripts/eval_selection.py against labelled footage -- that is what S17 exists for.
SELECTION_WEIGHT_HOOK=0.40
SELECTION_WEIGHT_PACE=0.20
SELECTION_WEIGHT_ENERGY=0.20
SELECTION_WEIGHT_LENGTH=0.20

# S15: de-duplication. Overlap is a fraction of the *shorter* candidate, so a short
# clip wholly inside a longer one reads as 1.0 rather than the small IoU that would
# let it ship as a separate file. Text similarity catches the other case: two clips
# from different parts of the video making the same point in the same words.
# Set either to 1.0 to disable that check.
SELECTION_MAX_OVERLAP=0.5
SELECTION_MAX_TEXT_SIMILARITY=0.7

# S6: relative weights inside the hook score (the first 2.5s of a candidate).
# Text signals are weighted lowest on purpose -- a keyword list is the component
# most easily fired by coincidence, so it nudges rather than decides.
HOOK_WEIGHT_PROMPTNESS=0.40
HOOK_WEIGHT_PACE=0.20
HOOK_WEIGHT_ENERGY=0.25
HOOK_WEIGHT_TEXT=0.15

# S2: audio-energy envelope resolution, in seconds per reading. One ffmpeg astats
# pass per source. Smaller resolves individual words and adds noise; larger blurs
# the laughs and shouts worth detecting.
ENERGY_ENVELOPE_WINDOW_S=1.0

# S10: annotate the transcript lines in the selection prompt with the measured pace
# and energy of each segment, so the model can see that a moment was loud or fast.
# Without this it sees only "[i] start-end: text" and has no acoustic information.
SELECTION_FEATURES_IN_PROMPT=true

# ------------------- Diarisation & speaker-aware reframe ---------------------
# Word timings carry no speaker identity, so offline diarisation is attribution
# by proxy. DIARIZATION_PAUSE_GAP ends a turn; DIARIZATION_HANDOFF_GAP is the
# much larger silence needed before the next turn is credited to a *different*
# speaker. Keeping them separate is deliberate: pauses just over 0.9s are routine
# inside one person's speech, and treating each as a hand-off reported a monologue
# as two speakers.
DIARIZATION_MAX_SPEAKERS=2
DIARIZATION_PAUSE_GAP=0.9
DIARIZATION_HANDOFF_GAP=2.5
REFRAME_SAMPLE_FPS=5             # face-sampling rate for speaker-aware reframe
REFRAME_SAMPLE_CAP=120           # max frames sampled per clip
# V6: max simultaneous speakers in a split-screen layout. 3 and 4 are now supported and lay out
# as a 2-column grid rather than a stack: four tiles stacked in a 1080x1920 frame are 1080x480
# slots, a 2.25:1 letterbox holding a crop of a face, whereas two columns give 540x960 portrait
# slots that match the shape of a head and shoulders. Left at 2 so existing installs render
# exactly as before; raise it if your source material actually has three or four speakers.
SPLIT_SCREEN_MAX_REGIONS=2
# V4: restart the reframe smoother at every shot change. The EMA otherwise carries the
# previous shot's framing across a cut and converges on the new one over the next second,
# which on screen looks like the crop searching for the subject after every cut. Costs one
# video-only decode per reframed clip.
REFRAME_RESET_ON_CUT=true
# V8: how often the follow-active crop position is updated. Was 12, which is visible as
# stepping when the subject moves quickly. This only lengthens the sendcmd script - the
# expensive part of reframe is face sampling, and that rate is REFRAME_SAMPLE_FPS above.
REFRAME_COMMAND_FPS=24
# V16: crop existing letterbox/pillarbox bars before reframing. Source footage is often
# already boxed (a 16:9 export inside a 1:1 frame, a re-upload from another platform), and
# reframing that centres the crop on the bars and bakes them into the vertical output.
AUTO_DELETTERBOX=true

# ---------------------------- Output geometry --------------------------------
# O5/O9: output resolution, named by its short side. Was fixed at the 1080-class values
# with no way to ask for anything else, so a 4K source was always downscaled and a
# low-powered host could not trade quality for encode time. 1080 is the short-form
# consensus. An unrecognised value falls back to 1080 rather than failing the render.
OUTPUT_SHORT_SIDE=1080           # 720 | 1080 | 1440 | 2160

# O7: target one platform's output profile instead of shipping the same file everywhere. Sets
# the resolution, the bitrate ceiling and the clip-length cap for that destination; a clip longer
# than the destination accepts otherwise fails at upload having already cost a full render.
#
# An explicit OUTPUT_SHORT_SIDE or OUTPUT_MAX_BITRATE_KBPS always wins - the profile only fills
# in values you have not chosen. The profile's *aspect* is advisory and is never applied
# silently: re-shaping an explicit 9:16 request into 16:9 because a platform was named would be
# a setting that fights the interface.
#
# Note this selects ONE profile. It does not render a variant per platform: that is N encodes, N
# thumbnails and N publish records per clip - a job-model change, not an encoder setting.
OUTPUT_PLATFORM=                 # tiktok | instagram | youtube | youtube_shorts | x | whop

# O12: how captions are delivered. Burned-in is the right default for short-form -- the feeds
# autoplay muted and nobody enables a subtitle track -- but it is a permanent, untranslatable,
# un-hideable decision baked into the pixels.
#
#   burned  the shipped behaviour: captions rendered into the video
#   soft    a selectable mov_text track instead; the video has no caption pixels
#   both    burned captions AND a soft track
#
# mov_text is plain text, so the preset animation, per-word highlighting, glyphs and positioning
# cannot survive in the soft track. That is a limitation of what MP4 can carry, not of this
# tool, and it is why `both` exists rather than `soft` simply replacing `burned`.
CAPTION_MODE=burned              # burned | soft | both

# ------------------------------ Look details ---------------------------------
# V11: what fills the frame around fitted video. This was one hard-coded look (boxblur 40
# plus a slight darkening), which suits talking-head footage and actively hurts other
# things -- a blurred screen recording is an unreadable smear, and gameplay footage becomes
# noise competing with the clip. 'black' is the honest choice for screen recordings;
# 'mirror' reads as intentional where a blur reads as a mistake.
BACKGROUND_STYLE=blur            # blur | mirror | black | color | gradient
BACKGROUND_COLOR=0x0F172A        # used when BACKGROUND_STYLE=color

# V13: the progress bar was a 12px bar in one cyan, always at the bottom -- where on a 9:16
# clip it sits directly under the captions and competes with them. 'track' adds a dim
# full-width rail, so how much is *left* is visible rather than only how much has passed.
PROGRESS_BAR_POSITION=bottom     # bottom | top
PROGRESS_BAR_STYLE=bar           # bar | track
PROGRESS_BAR_COLOR=0x22D3EE
PROGRESS_BAR_THICKNESS=12

# V9: which opening treatment the `transitions` flag applies. punch_in eases from 1.18x and
# reads as a camera move; zoom_cut steps with no easing and reads as an edit; whip_pan slides
# in laterally and decelerates; dissolve fades up from black.
#
# Note there is nowhere in this product for a literal clip-to-clip transition to live: every
# clip is an independent deliverable published separately, and a transition needs two shots
# that meet. These are the treatments of a clip's own opening.
TRANSITION_STYLE=punch_in        # punch_in | zoom_cut | whip_pan | dissolve

# AU4: speech de-noise. Off by default, and conservative when on: over-reduced noise leaves
# speech sounding underwater and gated, which is a worse defect than the room tone it removed.
# A slightly noisy clip is publishable; one that sounds processed is not.
#
# afftdn (spectral gating) is used unless SPEECH_DENOISE_MODEL points at a real arnndn model.
# arnndn is the better filter and IS compiled into ffmpeg, but ffmpeg ships no models -- they
# live in a separate repository -- so it is unavailable unless you supply one. A configured but
# missing model degrades to afftdn rather than failing the render.
SPEECH_DENOISE=off               # off | light | standard | strong
SPEECH_DENOISE_MODEL=            # path to an .rnnn model, e.g. ./assets/models/sh.rnnn

# AU5: de-esser, for sibilance on a harsh or close-miked source. Even "strong" is intensity 0.6,
# not 1.0: at full intensity the 4-8 kHz band loses so much energy that consonants lose
# definition, which is a different defect rather than a fix.
#
# AU5 also asks for de-reverb, and that is NOT implemented: ffmpeg has no de-reverb filter --
# not one this build lacks, one that does not exist upstream. Real de-reverberation needs
# spectral deconvolution or a trained model, i.e. an external dependency. A high-pass plus a
# gate is sometimes sold as "de-reverb"; it is not, and shipping it under that name would be
# worse than not shipping it.
DEESSER=off                      # off | light | standard | strong

# V18: a 3D LUT applied after the colour preset, for a look the five presets cannot express -
# a house grade, or a client's brand LUT, which is nearly always delivered as a .cube. Applied
# after the preset because a LUT maps final values; the reverse would feed its output back
# into a contrast curve. Empty means no LUT, and a missing file is ignored rather than
# failing the render.
COLOR_LUT=

# V19: ease the Ken Burns push instead of ramping it linearly. A constant rate is the one
# thing a camera move never does, and on a long clip the frame visibly creeps. Same start and
# end zoom; only the curve changes.
#
# Off by default, and deliberately so: this changes the rendered pixels, and the convention
# here - the same one TRANSITION_STYLE and the PROGRESS_BAR_* settings follow - is that a new
# visual setting defaults to whatever shipped, so the v0.8.0 byte-parity gate keeps meaning
# something. Turning this on is expected to change your output; that is the point of it.
ZOOM_EASE=false
# V19: bump the scale briefly on detected audio accents. This is onset detection over the
# energy envelope that is already measured for scoring - not beat tracking, so every bump sits
# on a real transient rather than an estimated tempo. Off by default: it suits music-led
# footage and is a distraction on a talking head.
BEAT_SYNC_ZOOM=false
BEAT_SYNC_RISE_DB=6.0            # level jump between readings that counts as an accent

# V17: score a few candidate frames when choosing the thumbnail rather than taking a fixed
# position, which on a clip opening on a cut or a blink picked exactly the wrong still.
# Scored on sharpness (motion blur is the most common way an auto thumbnail looks bad) and
# on mid-range exposure, so a near-black or blown-out frame loses.
SMART_THUMBNAIL=true

# V14: a closing call-to-action over the tail of the clip. Clips currently end the instant the
# speech does, which wastes the one moment a viewer has already decided to watch to the end.
#
# Rendered as a libass event, like every other piece of text here, so it survives an ffmpeg
# built without freetype. It fades in and settles upward, and deliberately does NOT fade out -
# the clip ends under it, and fading would take the words away at the decision point.
#
# Empty disables it. The hold is capped at half the clip length, so a 3-second clip does not
# become an advert with a clip attached.
END_CARD_TEXT=
END_CARD_SECONDS=2.0

# ------------------------------ Publishing -----------------------------------
# Persistent clip/publish history (SQLite) and the throttled scheduler.
HISTORY_DB=./storage/history.db
PUBLISH_POLL_SECONDS=2               # how often the scheduler checks for due posts
# A *floor* under each publisher's own rate limit, for operators who want to be
# more conservative than the platforms require. 0 means "trust each publisher"
# (whop 2s, x 5s, tiktok 10s, youtube 15s, instagram 18s). This replaced
# PUBLISH_DEFAULT_INTERVAL_SECONDS, which defaulted to 30 and therefore overrode
# every publisher's declared limit, making them all dead code.
PUBLISH_MIN_INTERVAL_FLOOR_SECONDS=0
# Public base URL of this server (used where a platform needs a reachable URL).
PUBLIC_BASE_URL=

# --- Whop (uploads/attachments via the official @whop/sdk Node bridge) -------
# The bridge lives in publisher_bridge/ and requires Node.js + `npm install`
# there (done automatically in the Docker image).
WHOP_API_KEY=
WHOP_COMPANY_ID=                     # optional default company/account (biz_xxx)
WHOP_NODE_BINARY=node                # path to the Node runtime for the bridge

# --- YouTube (Data API v3, OAuth 2.0 refresh-token flow; vertical => Shorts) -
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=                  # optional default channel

# --- TikTok (Content Posting API) --------------------------------------------
# Until your app passes TikTok's audit, uploads land in the user's inbox as a
# draft. Set TIKTOK_DIRECT_POST_APPROVED=true only once Direct Post is approved.
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_DIRECT_POST_APPROVED=false

# --- Instagram (Graph API, Professional account + Facebook Login) ------------
# Requires the instagram_content_publish permission (app review) to publish.
# Without it the adapter runs in review mode only.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_CONTENT_PUBLISH_APPROVED=false

# --- X / Twitter (API v2, OAuth user context) --------------------------------
# X has no API "draft"; posting requires an approved user-context token. Set
# X_DIRECT_POST_APPROVED=true only when your access level permits media posting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCOUNT_ID=
X_DIRECT_POST_APPROVED=false
