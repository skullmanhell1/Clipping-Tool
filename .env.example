# =============================================================================
# AI Video Clipper -- environment configuration
# Copy to `.env` and fill in the values you need. All keys are optional for
# booting the app; features that require a given key will be enabled in later
# phases as the keys are provided.
# =============================================================================

# --------------------------------- App ---------------------------------------
APP_NAME="AI Video Clipper"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
# Comma-separated list, or * for all. NOTE: while this is *, credentialed
# cross-origin requests are disabled — the CORS spec forbids combining a wildcard
# origin with Access-Control-Allow-Credentials and browsers reject the response.
# Set an explicit list (e.g. https://app.example.com) for a public deployment.
CORS_ORIGINS=*

# ------------------------------ Security -------------------------------------
# Shared secret required on every /api/* and /clips/* request. Leave empty and the
# app allows all requests and logs a loud warning at startup; under
# ENVIRONMENT=production an empty value refuses to boot instead, because
# render.yaml publishes this with autoDeploy and an unauthenticated deployment is
# not a state anyone chooses on purpose.
#
# Send it as `Authorization: Bearer <token>` or `X-API-Token: <token>`. Media under
# /clips/ additionally accepts `?token=<token>`, because a browser cannot attach a
# header to <video src>. That is deliberately limited to that read-only prefix, so
# no token ever appears in the URL of a request that changes anything.
#
# This is a single shared secret, not accounts. Per-user auth is plan item U12.
API_AUTH_TOKEN=

# Throttle the expensive routes (job submission, upload, preview, rerender,
# regenerate). In-process token bucket keyed by client, deliberately not Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30           # per client, per window
RATE_LIMIT_WINDOW_SECONDS=60.0

# URL ingest hands the URL to yt-dlp, which fetches whatever it is given — so
# without this an unauthenticated caller can use the API to reach the deployment's
# own network, including cloud metadata at 169.254.169.254. Leave false unless you
# genuinely ingest from a LAN media server.
URL_INGEST_ALLOW_PRIVATE=false

# Trust X-Forwarded-For when identifying a client for rate limiting. Enable ONLY
# behind a proxy that sets it (Render, nginx): there, without this, every request
# looks like the proxy and shares one bucket. Directly exposed, the reverse — a
# client can forge the header and appear as unlimited distinct clients.
TRUST_FORWARDED_FOR=false

# --------------------------------- LLM ---------------------------------------
# Pluggable client -- choose one provider. Only the matching key is required.
# Without any key the app still works using the deterministic (non-AI) fallback.
LLM_PROVIDER=openai              # openai | anthropic | gemini

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                 # optional: e.g. http://localhost:11434/v1 (Ollama)

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini (free tier available) -- get a key at https://aistudio.google.com/apikey
# Set LLM_PROVIDER=gemini to use these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Google's OpenAI-compatible endpoint; no need to change.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------- Transcription ----------------------------------
# T1: "small" rather than "base". A mis-transcribed word is burned into the video, and
# "base" is a noticeable accuracy step down. Larger models are better and cost more.
WHISPER_MODEL=small              # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto              # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 | int8_float16 | float16 | float32

# T4: text prepended to the decode so Whisper has a reason to expect unusual words.
# Without it a recurring proper noun is mis-transcribed the same way every time it is
# said, and that mistake is burned into every clip's captions. This is the standing
# list for a channel that always says the same handful of unusual words; per-video
# terms belong in the job's own `vocabulary` field, which is appended after this.
WHISPER_INITIAL_PROMPT=

# T5: voice-activity detection. It was switched on with every parameter left at the
# library default, so none of it could be adjusted for difficult audio. These *are*
# faster-whisper's defaults, so behaviour is unchanged until one is changed on purpose.
#
# Lower the threshold to keep quiet or distant speech the default discards; raise it to
# reject more room noise. Raising MIN_SPEECH_MS drops short interjections -- "yeah", a
# laugh -- which on the wrong footage is the punchline. SPEECH_PAD_MS too low clips the
# first and last phoneme of every utterance.
#
# Note: all of these are part of the transcript cache key, so changing one re-transcribes
# rather than serving a transcript decoded under the old settings.
WHISPER_VAD_FILTER=true
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_MIN_SILENCE_MS=2000
WHISPER_VAD_MIN_SPEECH_MS=250
WHISPER_VAD_SPEECH_PAD_MS=400

# -------------------------------- Storage ------------------------------------
STORAGE_BACKEND=local            # local | s3  (same code path either way)
STORAGE_ROOT=./storage
UPLOADS_DIR=./storage/uploads
TEMP_DIR=./storage/temp
CLIPS_DIR=./storage/clips
# Default retention window (days) for finished clips; 0 = keep forever. This is
# the default only -- it is adjustable at runtime from the Storage settings UI
# (persisted to storage/runtime_config.json) alongside the toggles below.
RETENTION_DAYS=30
AUTO_DELETE_TEMP=true            # delete a job's temp/scratch files when it ends
DELETE_LOCAL_AFTER_PUBLISH=false # delete the local clip after a successful publish
RETENTION_SWEEP_HOURS=6          # background retention sweep interval
DISK_WARN_FREE_GB=2              # warn in the UI when free space drops below this
DISK_WARN_PERCENT=90             # warn in the UI when used space exceeds this %
# Computing the per-area sizes shown by /api/storage walks clips/, uploads/ and
# temp/ in full, and the storage panel polls that endpoint. The figures are a
# rough gauge, so they are cached briefly. 0 = always recompute.
DISK_USAGE_CACHE_SECONDS=30
# Durable job/clip records. Without this the job store is process memory only, so
# a restart loses every job and the history view lists clips whose download 404s.
JOBS_DB=./storage/jobs.db
# Upper bound on retained job records, so the table cannot grow without limit.
# 0 disables pruning.
MAX_PERSISTED_JOBS=500
# Where the runtime-tunable settings and saved publishing profiles are persisted.
RUNTIME_CONFIG_PATH=./storage/runtime_config.json
PROFILES_PATH=./storage/profiles.json

# ------------------------------- Uploads -------------------------------------
# Guard rails on /api/upload. Without a ceiling any client can fill the disk, and
# without an allow-list arbitrary files land in a directory later fed to ffmpeg.
MAX_UPLOAD_BYTES=2147483648      # 2 GiB; 0 = unlimited
UPLOAD_CHUNK_BYTES=1048576       # 1 MiB streaming chunk
ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi,.m4v,.mpg,.mpeg,.wmv,.flv,.ts,.m2ts,.3gp,.mp3,.wav,.m4a,.aac,.flac,.ogg

# ------------------------- S3 (optional, if STORAGE_BACKEND=s3) --------------
# Flip STORAGE_BACKEND=s3 to store clips durably in S3 (or an S3-compatible
# service). The rest of the app is unchanged.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                 # optional, for S3-compatible providers

# ------------------------------ Updates --------------------------------------
# "Check for updates" compares VERSION to the latest GitHub release.
GITHUB_REPO=skullmanhell1/Clipping-Tool
UPDATE_CHECK_ENABLED=true

# -------------------------------- FFmpeg -------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# An ffmpeg built with `libvmaf`, used *only* by the fidelity gate's VMAF measurement.
# Empty means "use FFMPEG_BINARY", which is the right default for everyone not running the
# measurement harness: VMAF is then simply reported unavailable, by name, on a build without it.
#
# It is a second binary because no single build does both jobs. No mainstream distribution
# compiles `libvmaf` into its ffmpeg, so the primary binary cannot measure VMAF; and the
# third-party builds that do carry it signal colour differently — the one tested here leaves
# `color_transfer` and `color_primaries` unset where the distribution build writes them, which
# the colour-pipeline checks read. Pointing FFMPEG_BINARY at such a build to gain VMAF would
# trade one set of failures for another, so only this measurement moves.
VMAF_FFMPEG_BINARY=
# Wall-clock ceilings for media subprocesses. Jobs run in a single-worker thread
# pool, so an ffmpeg that hangs would otherwise block the whole queue forever with
# no error. Encoding gets a generous ceiling (a long source legitimately takes
# minutes); probing is metadata-only. Set either to 0 for no ceiling.
FFMPEG_TIMEOUT_SECONDS=3600
FFPROBE_TIMEOUT_SECONDS=60
# x264 quality and speed for every rendered clip. Lower CRF is better quality and a
# bigger file; 18-23 is the sane range. Presets trade encode speed for efficiency
# (ultrafast..veryslow). Output is always 8-bit yuv420p / High profile / level 4.0,
# which is what makes clips playable everywhere -- that is not configurable on purpose.
# S3: measure pitch variation per candidate (animated vs monotone delivery) and feed it to
# ranking and the LLM prompt. Measured against the speaker's OWN median in semitones, so a
# low-pitched or high-pitched voice is not advantaged. No model, no network.
#
# Costs one additional pass over the source audio, so it is opt-in. PROVISIONAL and OFF: without
# the S1 labelled benchmark nothing can show that an added signal improves the ranking rather than
# just changing it, and eval/labels/ is still a .gitkeep.
SELECTION_PITCH_FEATURE=false

X264_CRF=20
# MEASURED and deliberately unchanged (O16). On a 4K->1080x1920 downscale, slower presets beat
# veryfast by +0.68..+1.14 VMAF on one source and LOST by -0.19..-0.59 VMAF on another. What they
# reliably bought was a smaller file at equal CRF, not fidelity -- which is textbook x264. The
# requirement says change the default only if the measurement supports it; it does not.
# Full table: eval/baselines/encode_presets_v0.11.0.json
X264_PRESET=veryfast

# V20: deinterlacing. Combing that reaches the crop and scale becomes a smear no later filter can
# undo, so this runs first -- ahead of the tone-map, because mapping interleaved fields blends two
# different moments in time.
#
# ON by default, and safe to be: it fires only when the container's declared field_order AND
# ffmpeg's idet measurement both say interlaced. Either signal alone is not enough. idet
# false-positives badly on fine horizontal detail -- measured at ~85% interlaced on a definitively
# progressive source, because venetian blinds, fences and small text look like combing to it -- and
# deinterlacing progressive footage destroys vertical detail irreversibly. Where the two disagree
# the clip records `deinterlace_inconclusive` and nothing is done.
DEINTERLACE=true
# Emit one frame per field (25i -> 50p). Off: sounds like a free upgrade, and interacts badly with
# FRAME_RATE_POLICY and KEYFRAME_SECONDS, both of which read the delivered rate.
DEINTERLACE_DOUBLE_RATE=false

# V22: headroom. reframe centres the crop on the detected face centre, which is the most
# recognisable auto-crop tell -- a human editor places the eyes near the upper third -- and it
# pushes the MOUTH toward the middle of a 9:16 frame, exactly where captions sit. So centred
# framing actively creates the collision CAPTION_AVOID_FACES exists to work around.
#
# A fraction of CROP height, so the same value composes identically on a 1080p and a 4K source.
# Applied AFTER EMA smoothing -- folding it in earlier would let it re-ramp after every detected
# cut, which reads as bad tracking -- and clamped so it can never push the crop outside valid
# pixels.
#
# ZERO by default, reproducing v0.11.0 framing exactly. A look change needs a preference trial
# (M12) to justify a value; 0.05-0.10 is the plausible range to trial.
REFRAME_HEADROOM_BIAS=0.0

# V24: screen-recording and graphics detection. A 16:9 slide cropped to 9:16 delivers an
# unreadable middle third, and the pipeline had no notion of content type at all.
#
# Classified PER CLIP from two signal features -- mean temporal difference and luma-histogram
# entropy -- with no model and no network. The rule is a CONJUNCTION and that matters: measured,
# nearly-still camera footage has entropy 0.232, inside the range flat UI occupies (0.116-0.150),
# so thresholding entropy alone would letterbox a face. What separates them is that sensor noise
# means camera footage cannot produce a zero temporal difference -- the still camera fixture read
# 0.899 against 0.000 for slides.
#
# HIGH PRECISION, LOW RECALL, on purpose. Zero false positives across six measured fixtures.
# Flat-colour animation and screen recordings of moving video ARE missed and fall through to
# 'unknown', which runs the existing behaviour unchanged -- a missed slide costs nothing new,
# whereas a false positive wastes half the frame.
CONTENT_CLASS_DETECT=true
# auto | camera | screen. Forces the decision; skips the measurement entirely.
CONTENT_CLASS_OVERRIDE=auto

# V21: optional stabilisation, 0.0-1.0. Handheld footage under a MOVING crop compounds: the camera
# shakes and the reframe crop chases the shake, so the delivered clip moves more than the source did.
#
# OFF by default. It costs a real second pass (vidstabdetect must see every frame before
# vidstabtransform can act), and it gives up frame: up to 4% of each dimension is reserved as
# correction margin at full strength.
#
# That margin is the interesting part. vidstab could hide its shifted edges by ZOOMING, but that
# changes subject scale by an amount depending on how shaky the footage was -- so two clips from one
# source would be framed differently for reasons nobody chose. Instead optzoom is disabled and the
# reserved band is handed to reframing through the same content-rectangle mechanism V16 letterbox
# handling uses, so the two never consume the same pixels and the clip has no black edges.
#
# Never applied to content V24 classifies as a screen recording: vidstab finds spurious motion in
# scrolling text and introduces a wobble that was not there.
STABILISE_STRENGTH=0.0

# AU11: speech presence and dynamic control, 0.0-1.0.
#
# LOUDNORM SETS LEVEL, NOT SPECTRUM. Before this, the only spectral shaping anywhere in the audio
# path was a lowpass inside the music synthesiser -- so a clip normalised to exactly the right LUFS
# could still be muddy and hard to follow on a phone speaker, which is where nearly all short-form
# video is watched.
#
# At full strength: an 80Hz high-pass (handling noise, desk thumps and HVAC all sit below speech,
# and a phone speaker cannot reproduce that band anyway), a 3dB cut at 250Hz (the "boxy" region), a
# 3dB lift at 2.8kHz (consonant definition -- the band that carries WHICH WORDS rather than how
# loud), and a gentle 2:1 compressor. Every gain scales with the setting, so it is a continuous
# control rather than a three-position switch.
#
# SPEECH ONLY: applied before the music bed and b-roll are mixed in. Shaping a music bed for
# consonant definition is meaningless, and compressing it would fight AU2's ducking.
#
# BEFORE loudness normalisation, so the measured loudness reflects what is delivered. AU1's
# two-pass loudnorm and AU3's true-peak limiting are untouched.
#
# ZERO by default. This is audible processing and needs a preference trial (M12) to justify a
# value -- a clip that sounds processed is worse than one that sounds slightly dull.
SPEECH_PRESENCE=0.0

# AU12: match the two speakers' levels against each other inside a clip.
#
# AU1's loudnorm normalises the clip as a whole, so it moves both speakers by the same amount and
# preserves the imbalance exactly. A clip at a correct -14 LUFS can still have one speaker 8dB
# below the other. This measures each diarised turn against the 1-second energy envelope S2
# already computes -- so it costs no extra audio pass -- and applies a bounded, ramped `volume`
# expression on the speech branch before loudnorm.
#
# Bounded to +/-6dB, ramped over 120ms rather than stepped, and it declines rather than guessing:
# a single speaker, more than 24 turns, or turns too quiet to measure all leave the audio alone
# and say so in Effects_Applied.
#
# OFF by default, and it requires DIARIZATION=true -- it will never switch diarisation on as a
# side effect. With diarisation off it records `turn_gain_unavailable:diarization_disabled` and
# changes nothing. PROVISIONAL: diarisation here is a transcript proxy capped at two speakers, and
# a mislabelled turn would correct the wrong voice, which is worse than the imbalance.
TURN_GAIN_ENABLED=false

# O13/O14/O15: colour handling for delivery.
#
# TONE_MAPPING is ON by default, which is this project's only output setting that does not
# default to previously shipped behaviour. That rule protects the parity goldens from an
# accidental change and it is the right rule -- but it protects goldens, not defects, and an HDR
# source rendered with no tone-map is delivered grey, flat and desaturated. It costs nothing on
# SDR footage: the conversion fires only when the source's transfer function positively reports
# PQ (smpte2084) or HLG (arib-std-b67). Bit depth and resolution are deliberately never used to
# infer HDR, because 10-bit Rec.709 and 4K SDR are both ordinary.
#
# Measured on a synthetic PQ/BT.2020 source: mean saturation 112 -> 143, mean luma 125 -> 80.
# A controlled demonstration that the conversion works, not a claim about real footage.
TONE_MAPPING=true
# hable | mobius | reinhard | clip | linear. PROVISIONAL, not measured -- the right operator is
# content-dependent and genuinely contested. 'hable' keeps shadow and highlight detail at slight
# cost to contrast, which is the safer trade for footage a viewer has never seen the original of.
TONE_MAP_OPERATOR=hable
# Target peak luminance in nits. PROVISIONAL, not measured. 100 is SDR reference white.
TONE_MAP_TARGET_NITS=100
# tv (limited) or pc (full). 'tv' is what H.264 streaming means by default and what platforms
# expect. Full-range sources are *converted* rather than passed through, which is what stops
# phone footage crushing its blacks -- the most common colour defect in the wild. The conversion
# uses `scale`, present in every ffmpeg build, so unlike tone-mapping it never degrades.
DELIVERY_COLOUR_RANGE=tv

# O17: swscale resampling, applied uniformly to every scale in a job.
# bicubic | bilinear | lanczos | spline | neighbor | area | gauss
# bicubic is swscale's own default, so this changes no pixels. MEASURED on the 4K->1080x1920
# downscale: lanczos VMAF -0.07 / SSIM +0.0009 (within noise), bilinear VMAF -2.80 (clearly
# worse), neighbor VMAF +0.75 but PSNR -1.02 (VMAF fooled by false sharpening). Kept as-is per
# the "if the measurement does not distinguish them, keep the default" rule.
SCALER_FLAGS=bicubic

# O20: delivered AAC bitrate in kbps. UNMEASURED and therefore unchanged -- this project has no
# audio-fidelity instrument (M9's metrics are all image metrics), so 128 is the shipped value
# rather than a justified one. Raise it if you can hear the difference under a music bed.
AUDIO_BITRATE_KBPS=128

# O18: frame-rate policy.
#   auto   - preserve a CONSTANT-rate source already at 24/25/30/50/60; normalise everything else
#            (VFR, undeterminable, and CFR at unusual rates like 15 or 29.97).
#   always - the previous unconditional resample to OUTPUT_FPS.
# 'auto' exists because resampling CFR 24 to 30 inserts 3:2 judder into footage that had none.
# 'always' remains because VFR really does drift burned captions -- that half of the old rule was
# correct, and only its scope was wrong. Narrowing it is gated on A/V sync being verified at every
# deliverable rate (M11); see tests/test_frame_rate_policy.py.
FRAME_RATE_POLICY=auto

# O19: keyframe interval in SECONDS for delivered clips. Nothing set -g before, so x264's default
# of 250 frames applied -- about 8s at 30fps, which makes scrubbing coarse and gives a platform's
# thumbnail picker almost nothing to choose from. Expressed in seconds rather than frames because
# O18 makes the delivered rate vary: a fixed -g 60 would mean 2s at 30fps and 1s at 60fps.
# Scene-change keyframes are deliberately kept (no -sc_threshold 0).
KEYFRAME_SECONDS=2.0

# C24: cue legibility floors. words_to_cues has only ceilings (max_words/max_gap/max_duration) and
# no floor, so fast speech yields ~0.3s cues -- nine frames, a flicker rather than a caption.
#
# BOTH SHIP OFF, which reproduces v0.11.0 output exactly. PROVISIONAL: neither has been measured,
# and M10 (caption alignment) plus M12 (preference trials) are what would justify a value. A cue is
# first extended into free time, then merged with its neighbour if that still fits the line budget,
# and is never made to overlap -- non-overlap outranks both floors, and a relaxation is recorded on
# the clip rather than chosen silently. Word timings are never altered, so karaoke keeps tracking
# speech.
MIN_CUE_SECONDS=0.0
MAX_READING_RATE=0.0

# C25: prefer line breaks at linguistic boundaries (not after "the", not inside a proper noun)
# rather than purely by measured width. PROVISIONAL and off. English only: the rules are a
# hand-audited function-word list with no model and no network, so every other language falls back
# to width-based breaking. The measured width budget always outranks the preference.
CAPTION_LINGUISTIC_BREAKS=false

# C23: minimum rendered duration for a single caption WORD span, in seconds. 0 disables the floor.
#
# This is the floor only. The rest of word-span hygiene -- pulling an out-of-order start forward and
# truncating a span that overruns the next word -- runs unconditionally, because a karaoke fill that
# sweeps backwards and two words highlighted at once are rendering faults rather than looks anyone
# chose. Whisper emits such spans occasionally, and clip-relative rebasing produces zero-length ones
# at a window edge. A transcript whose spans already comply is returned untouched, object for object,
# so a well-formed render is bit-identical.
#
# The floor ships at zero because it is the one part that alters correct measurements: below roughly
# 80ms a highlight reads as a flicker rather than a word being lit, but the value that matters is
# perceptual and only M12 preference trials could settle it. Non-overlap and the cue's own end both
# outrank it, and a span pinned short by its neighbour is reported rather than forced.
MIN_WORD_SPAN_SECONDS=0.0

# S9: snap clip starts to shot boundaries so a clip does not open mid-shot. Detection uses
# ffmpeg's luma-based scene score over a narrow window near each boundary - it finds most hard
# cuts and misses ones between shots of similar brightness, which is why the shift is capped.
SCENE_SNAP_ENABLED=true
SCENE_SNAP_THRESHOLD=0.3
SCENE_SNAP_WINDOW_S=2.0
SCENE_SNAP_MAX_SHIFT_S=1.0
# O3: delivered clips are encoded at this constant frame rate. Variable-frame-rate sources
# (screen recordings, most phone footage) otherwise let burned captions drift against speech.
OUTPUT_FPS=30
# O4: a VBV ceiling for delivered clips. -crf alone sets a quality target with no bitrate
# limit, so a busy clip can balloon past a platform's file-size cap and be rejected.
OUTPUT_MAX_BITRATE_KBPS=12000
# AU8: neither was set anywhere, so output audio was whatever the source happened to be -
# 44.1 kHz mono from a phone, 48 kHz 5.1 from a camera.
OUTPUT_SAMPLE_RATE=48000
OUTPUT_CHANNELS=2
# AU1: loudness targets. A clip quieter than the platform's target is turned *up* on
# playback, lifting its noise floor along with the speech. Per-platform targets live in
# worker/effects/audio.py (YouTube -14, TikTok/Instagram -11); this is the fallback.
LOUDNESS_TARGET_LUFS=-14.0
LOUDNESS_TRUE_PEAK_DB=-1.0
# AU2: how hard the music bed is pushed down while someone is speaking. 1.0 disables
# ducking and restores the old flat mix, which either buries speech or is inaudible.
MUSIC_DUCK_RATIO=8.0
# AU3: a true-peak limiter at the end of the audio chain, at LOUDNESS_TRUE_PEAK_DB. Guards the
# paths where loudness normalisation does not run: a hot source plus a music bed sums past full
# scale (measured at +5.5 dBFS true peak without it).
TRUE_PEAK_LIMIT_ENABLED=true
# V10: filler removal joins kept segments sample-exactly, so each seam was a step in the
# waveform - the click you hear at every removed "um". 0 restores the hard cut.
FILLER_SEAM_FADE_MS=12

# -------------------------------- Assets -------------------------------------
EMOJI_ASSETS_DIR=./assets/emoji
# Bundled caption fonts, described by assets/fonts/fonts.json. Passed to libass as
# 'fontsdir', so captions render in the intended face even on a host with no fonts
# installed. Point this elsewhere only if you have registered those faces yourself.
FONT_ASSETS_DIR=./assets/fonts
# Optional: drop your own licensed mood tracks here. If absent, a copyright-free bed is
# synthesised (see MUSIC_ALLOW_SYNTHESIS - it is a drone, not music).
#
# A17: several tracks per mood are supported, and wanted. One track per mood meant every clip in
# a batch of ten carried the same bed, which is the most obvious way a set of clips reads as
# machine-produced. Three layouts, so holding twenty tracks does not have to look like holding
# one:
#   upbeat.mp3                      a single track  (the original layout, still first)
#   upbeat/*.mp3                    a directory per mood  (what a real library looks like)
#   upbeat_2.mp3, upbeat-3.mp3      numbered siblings
#
# Which track a clip gets is *deterministic*, not random: it is hashed from the source filename,
# the clip's ordinal and its start time. So ten clips from one source get different beds, and
# re-rendering the same job gives the same beds - which matters both for the golden-render check
# and for a creator re-rendering one clip of ten to fix a typo. The clip record carries a
# `music_track:2/5` marker so the variety is visible rather than assumed.
MUSIC_DIR=./assets/music
# AU9: drop your own sting files here as <name>.wav - pop, click, whoosh, swipe. A user file always
# wins over the synthesised version.
SFX_DIR=./assets/sfx

# ----------------------------- Effects (P4) ----------------------------------
# The emoji the built-in keyword map can produce are committed under assets/emoji
# (Noto Emoji 512px, OFL-1.1, fetched by scripts/fetch_emoji.py), so rendering needs no
# network. This URL is only consulted for a glyph that is not vendored, and only when
# EMOJI_ALLOW_DOWNLOAD is turned on.
EMOJI_CDN_BASE=https://raw.githubusercontent.com/googlefonts/noto-emoji/main/png/512
EMOJI_ALLOW_DOWNLOAD=false
# A13: which artwork set the emoji come from - noto | twemoji | openmoji. This is a *look*
# choice, not a technical one: Noto's flat shapes, Twemoji's rounder ones and OpenMoji's
# outlined drawings read very differently over footage.
#
# Only Noto is vendored, and deliberately so: committing three sets for 326 glyphs would triple
# the ~7 MB the assets already cost to ship two sets most installs never select. Selecting
# another therefore needs EMOJI_ALLOW_DOWNLOAD=true, or run
#   python scripts/fetch_emoji.py --style twemoji
# once to vendor it. A glyph missing from the selected style falls back to the Noto file rather
# than dropping the overlay - a mixed-style overlay is visible and correctable, a missing one
# looks like the feature is broken.
#
# Note Twemoji publishes at 72px, which is *smaller* than every size this tool composites at, so
# choosing it is choosing a slightly soft overlay. Noto (512px) and OpenMoji (618px) downscale.
EMOJI_STYLE=noto
# C19: where emoji sit in the frame. 'spread' is the shipped behaviour - three fixed slots
# across the frame, chosen so two glyphs never collide. 'caption' places each glyph just
# clear of the caption block instead, on the side the highlighted word is not occupying.
# That reads as deliberate only because C19 puts the emoji on the word the caption actually
# highlighted (it takes the highlighter's own keyword indices, not an independent salience
# ranking): a glyph pinned beside a caption while illustrating some other word in the cue
# looks like a bug. Default stays 'spread' so an upgrade does not move existing output.
EMOJI_PLACEMENT=spread
# Default background-music level (0..1) mixed under the original audio.
MUSIC_DEFAULT_VOLUME=0.12
# A15: the fallback "music" bed is not music - it is two sine tones with tremolo, identical
# for every clip of a given mood. Drop your own licensed tracks in MUSIC_DIR to get a real
# bed; set this to false to render silence instead of a drone when you have none. Clips that
# use the fallback are marked music_degraded:synthesised.
MUSIC_ALLOW_SYNTHESIS=true

# T8: ASR is the most expensive stage and the most repeated - re-running a source to try a
# different caption preset or aspect ratio re-transcribes audio that has not changed. The key
# covers the source's content hash *and* the ASR settings, so upgrading WHISPER_MODEL or
# re-exporting the footage misses the cache rather than serving a stale transcript.
# T3: Whisper invents text over music, applause and silence, and gets stuck in decode loops.
# Every threshold is set so two independent signals must agree before a segment is dropped: a
# false positive deletes real speech and nothing downstream can notice, while a missed
# hallucination is visible in the clip. NO_SPEECH and LOGPROB must coincide; neither acts alone.
TRANSCRIPT_FILTER_ENABLED=true
TRANSCRIPT_NO_SPEECH_THRESHOLD=0.6
TRANSCRIPT_LOGPROB_THRESHOLD=-1.0
TRANSCRIPT_MAX_TOKEN_RUN=4
TRANSCRIPT_MAX_SEGMENT_REPEATS=2
TRANSCRIPT_MIN_WORD_PROBABILITY=0.35
# Below this share of surviving segments nothing is dropped at all: if most of a transcript
# looks invented the thresholds are wrong for that audio, and emptying it is worse than
# keeping a poor transcript.
TRANSCRIPT_FILTER_KEEP_FLOOR=0.5

TRANSCRIPT_CACHE_DIR=./storage/transcripts
TRANSCRIPT_CACHE_ENABLED=true

# I3: cache the OTHER whole-file decodes, keyed by source content hash like the transcript cache.
#
# T8 cached transcription and stopped there, so three full decodes still ran on every job for the
# same source: silence detection (silencedetect cannot work without decoding the audio), the
# energy envelope (one astats pass over the whole file), and keyframe sampling (48 seeks at
# 480 px). None depends on anything a user changes between runs, so re-running a source to try a
# different caption preset paid for all three again.
#
# Keyed on content rather than path and mtime, for the same reason as T8: the usual shortcut is
# wrong in exactly the case that matters, footage re-exported over the same filename. Every
# parameter that changes the answer is in the key too -- a silence map measured at -30 dB is not
# interchangeable with one at -25.
#
# The keyframe part is a directory of JPEGs rather than JSON, which is the larger part of the
# cache on disk. MAX_ENTRIES bounds it; 0 disables pruning, which on a long-lived instance is a
# slow disk leak.
INTERMEDIATE_CACHE_ENABLED=true
INTERMEDIATE_CACHE_DIR=          # empty = <TEMP_DIR>/intermediates
INTERMEDIATE_CACHE_MAX_ENTRIES=200

# ------------------------------- B-roll --------------------------------------
# Local b-roll library and its cache. BROLL_PROVIDER is empty by default, which
# means local assets only -- no network. Set a provider plus its key to allow
# fetching, and BROLL_ALLOW_DOWNLOAD=true to permit the fetch itself.
BROLL_DIR=./assets/broll
BROLL_CACHE_DIR=./assets/broll_cache
BROLL_PROVIDER=
BROLL_PROVIDER_API_KEY=
BROLL_PROVIDER_BASE_URL=
BROLL_ALLOW_DOWNLOAD=false
# A19: describe your local library in BROLL_DIR/tags.json and matching stops depending on
# filenames:
#   { "pexels-4276282.mp4": ["cash", "wallet"], "sunrise-timelapse.mp4": "morning sun dawn" }
# Without it, matching falls back to filename tokens, which is what it did before - but the old
# substring test also matched a file called `on.mp4` against the keyword "money" and picked
# whichever file the directory happened to list first. Tags score highest, then synonyms (taken
# from the emoji keyword map, so there is only one word list to maintain), then filename tokens;
# the best-scoring file wins, ties broken by name so two machines agree.
#
# A22: motion on b-roll *stills*. A still that sits motionless over moving footage is the clearest
# sign a clip was assembled rather than edited. Off by default because it changes the shipped
# look: with it on, stills are cover-cropped into a fixed 16:9 box, because ffmpeg's zoompan
# requires an explicit output size and the default graph does not know the scaled height.
# Video assets already move and are never touched.
BROLL_KEN_BURNS=false
# How far a still zooms across its whole window, as a fraction. Deliberately small - motion that
# is *noticeable* on a two-second overlay is distracting rather than cinematic. The zoom converges
# on an anchor that rotates per cue, which supplies the drift and stops four stills in one clip
# all moving identically.
BROLL_KEN_BURNS_ZOOM=0.12
# A22: how far the music bed dips while a b-roll overlay is on screen, as a fraction. 0 leaves the
# audio graph untouched; 0.35 is a clearly audible accent. Applied to the *bed* only - the b-roll
# is illustrating what is being said, so ducking the speech would invert the point. This is in
# addition to the AU2 speech duck, so during b-roll over speech the bed is under both.
BROLL_DUCK=0.0

# ---------------------------- Caption placement ------------------------------
# C12: platform UI safe areas. The caption margins were hard-coded at 220/200 and are not
# TikTok-aware, so a caption could sit under the username, the platform's own caption text
# or the action rail -- unreadable, and invisible to the creator because that chrome is not
# in the rendered file. Insets are fractions of frame height, so they hold at every
# OUTPUT_SHORT_SIDE. Empty selects the generic profile, which reproduces the previous
# margins exactly at 1080x1920 (200 top / 220 bottom / 80 side).
CAPTION_SAFE_AREA=              # tiktok | instagram | youtube | none  (empty = generic)
# C13: extra distance between the caption and its edge, in pixels. Positive only -- a
# negative value would push text into the chrome the safe area exists to avoid.
CAPTION_OFFSET_PX=0

# C22: mask profanity in burned captions, keeping the first letter and the word's length
# ("f******!") so the sentence stays readable. Off by default on purpose: burned captions
# are permanent, and a creator whose voice is profane should not be censored by their own
# tool. The list is deliberately short and matches whole words only, so "classic" and
# "Scunthorpe" are untouched -- a masked word inside an innocent one is far more
# conspicuous than an unmasked profanity, because the viewer can see the tool got it wrong.
CAPTION_MASK_PROFANITY=false

# ---------------------------- Clip selection ---------------------------------
# Visual selection samples this many keyframes per source and blends their
# brightness/motion cues with the transcript score. The weight is 0..1:
# 0 = transcript only, 1 = visuals only. Brightness and motion are weak signals
# for talking-head footage, where the transcript is the better guide.
#
# S14: the count was 12 and the width 160, at which the signal cannot do its job -
# 12 frames across an hour is one every five minutes, so every candidate in a
# five-minute stretch scored identically, and a 160px thumbnail averages away the
# frame-to-frame difference the motion proxy is meant to detect.
KEYFRAME_SAMPLE_LIMIT=48
KEYFRAME_SAMPLE_WIDTH=480
VISUAL_SELECTION_WEIGHT=0.5

# Per-signal weights for the deterministic fallback's ranking (S11, S17). They are
# relative and the scorer normalises by their total, so only the ratios matter.
# These replace the old rule of keeping the *longest* segments, which is worse than
# arbitrary: the longest silence-delimited segment is usually the stretch where
# nobody paused, and a punchy fifteen-second exchange lost to it every time.
#
# The defaults are a starting point, not a measured optimum. Tune them by running
# scripts/eval_selection.py against labelled footage -- that is what S17 exists for.
SELECTION_WEIGHT_HOOK=0.40
SELECTION_WEIGHT_PACE=0.20
SELECTION_WEIGHT_ENERGY=0.20
SELECTION_WEIGHT_LENGTH=0.20

# S7/S8/S12: what a passage SAYS, alongside how it was delivered. Selection measured pace, energy
# and how promptly a clip opens, and nothing about the words.
#
#   structure  (S7)  a question with its answer, or an enumeration ("three things", "here's why"),
#                    is a self-contained unit by construction: it opens with a promise and closes
#                    by keeping it. An UNANSWERED question scores lowest of all -- it opens a loop
#                    the clip never closes, which is the commonest way an auto-cut moment feels
#                    unfinished.
#   standalone (S12) whether the window makes sense without what came before. A clip opening on
#                    "and that's why he did it" is a fragment of a conversation, and no amount of
#                    pace or energy makes it publishable.
#   intensity  (S8)  how emphatically it is worded, from the vocabulary rather than the acoustics.
#                    Energy (S2) measures how loudly someone spoke; this measures whether they had
#                    anything emphatic to say.
#
# All three are LEXICAL rules, not model calls. S8 asks for sentiment "via the LLM", and the reason
# it is not is the same one S4 records: a per-segment request costs money per job, and nothing can
# yet tell whether a scored signal improves selection because the S1 labelled dataset does not
# exist. A paid, unvalidated signal makes an improvement and a regression indistinguishable.
#
# Weighted below the delivery signals deliberately. These read ASR output, so they are the least
# certain measurements here -- one mis-transcribed opener can make a complete thought look like a
# fragment -- and a weight large enough to overturn the acoustic signals would be a guess with
# consequences. `standalone` is highest of the three because nothing downstream can supply context
# a clip is missing, whereas boundary snapping can still fix an unfinished ending. `intensity` is
# lowest because it overlaps with ENERGY, and double-counting emphasis would let one loud,
# strongly-worded moment dominate a whole source.
SELECTION_WEIGHT_STRUCTURE=0.15
SELECTION_WEIGHT_STANDALONE=0.20
SELECTION_WEIGHT_INTENSITY=0.10

# S15: de-duplication. Overlap is a fraction of the *shorter* candidate, so a short
# clip wholly inside a longer one reads as 1.0 rather than the small IoU that would
# let it ship as a separate file. Text similarity catches the other case: two clips
# from different parts of the video making the same point in the same words.
# Set either to 1.0 to disable that check.
SELECTION_MAX_OVERLAP=0.5
SELECTION_MAX_TEXT_SIMILARITY=0.7

# S6: relative weights inside the hook score (the first 2.5s of a candidate).
# Text signals are weighted lowest on purpose -- a keyword list is the component
# most easily fired by coincidence, so it nudges rather than decides.
HOOK_WEIGHT_PROMPTNESS=0.40
HOOK_WEIGHT_PACE=0.20
HOOK_WEIGHT_ENERGY=0.25
HOOK_WEIGHT_TEXT=0.15

# S2: audio-energy envelope resolution, in seconds per reading. One ffmpeg astats
# pass per source. Smaller resolves individual words and adds noise; larger blurs
# the laughs and shouts worth detecting.
ENERGY_ENVELOPE_WINDOW_S=1.0

# S10: annotate the transcript lines in the selection prompt with the measured pace
# and energy of each segment, so the model can see that a moment was loud or fast.
# Without this it sees only "[i] start-end: text" and has no acoustic information.
SELECTION_FEATURES_IN_PROMPT=true

# ------------------- Diarisation & speaker-aware reframe ---------------------
# Word timings carry no speaker identity, so offline diarisation is attribution
# by proxy. DIARIZATION_PAUSE_GAP ends a turn; DIARIZATION_HANDOFF_GAP is the
# much larger silence needed before the next turn is credited to a *different*
# speaker. Keeping them separate is deliberate: pauses just over 0.9s are routine
# inside one person's speech, and treating each as a hand-off reported a monologue
# as two speakers.
DIARIZATION_MAX_SPEAKERS=2
DIARIZATION_PAUSE_GAP=0.9
DIARIZATION_HANDOFF_GAP=2.5
REFRAME_SAMPLE_FPS=5             # face-sampling rate for reframe
# Was 120, which is below the configured rate for any clip over 24 seconds: the sampling step
# is widened until the frame count fits, so a 60s clip was sampled at 2 fps and a 90s clip at
# 1.33, and nothing reported that REFRAME_SAMPLE_FPS was not being honoured. Measured against
# a ground-truth path, that took the p95 crop-centre error from 76 px at 5 fps to 153 px at
# 1.33, inside a 608 px-wide crop window. 900 is the full 5 fps for a 180s clip - the longest
# the `90s-3min` preset produces - so the cap no longer lowers the rate within the range this
# tool renders, while still bounding the cost beyond it.
REFRAME_SAMPLE_CAP=900
# Width the frame is scaled to before face detection; boxes are scaled back afterwards, so
# this changes cost, not coordinates. Detection dominated sampling - on a 60s 1080p clip, 300
# sampled frames cost 5.5s of detection against a fixed 2.2s of decode - and that cost is
# what forced the cap above down to a rate that could not follow a moving subject. On a real
# photograph, detecting at 320 px instead of 512 moved the resolved centre by 1.4 px.
# 640 keeps the cascade's minimum face size at 20 px on 1080p, above the floor where Haar
# becomes unreliable; a narrower frame would quietly make detection stricter. 0 = native.
REFRAME_DETECT_WIDTH=640

# ---- Face detection ----
# Which detector finds the faces the crop follows. `haar` is the shipped OpenCV cascade
# and stays the default, so an unchanged configuration reproduces existing output exactly.
# `mediapipe` uses the vendored BlazeFace model (assets/models/) and finds faces in profile
# and at a distance that Haar misses; it is opt-in per job or here.
FACE_DETECTOR_BACKEND=haar       # haar | mediapipe
# Minimum MediaPipe detection confidence; below this a detection is discarded. Haar reports
# no confidence, so this affects the mediapipe backend only.
FACE_DETECTOR_MIN_SCORE=0.5
# Detection coverage (fraction of sampled frames containing a face) below which the clip
# records `reframe_low_confidence:<coverage>`. A STARTING value, not a measured one: it is
# the point at which the crop path is interpolated across more frames than it is anchored
# by. Choosing it properly needs the labelled selection benchmark (M4/S1).
REFRAME_COVERAGE_FLOOR=0.35
# Where the vendored detector models live. A setting because the container and the working
# tree put them in different places; verify the contents with
# `python scripts/fetch_models.py --check`.
FACE_MODEL_DIR=./assets/models
# V6: max simultaneous speakers in a split-screen layout. 3 and 4 are now supported and lay out
# as a 2-column grid rather than a stack: four tiles stacked in a 1080x1920 frame are 1080x480
# slots, a 2.25:1 letterbox holding a crop of a face, whereas two columns give 540x960 portrait
# slots that match the shape of a head and shoulders. Left at 2 so existing installs render
# exactly as before; raise it if your source material actually has three or four speakers.
SPLIT_SCREEN_MAX_REGIONS=2
# V4: restart the reframe smoother at every shot change. The EMA otherwise carries the
# previous shot's framing across a cut and converges on the new one over the next second,
# which on screen looks like the crop searching for the subject after every cut. Costs one
# video-only decode per reframed clip.
REFRAME_RESET_ON_CUT=true
# The reframe smoother used to be causal: every output depended only on samples at or before
# it, so the crop trailed the subject and overshot when they stopped. Measured against a
# ground-truth path with the subject panning 500 px/s, that was a mean centre error of 40 px
# and a p95 of 159 px inside a 608 px-wide crop window. The whole face path is known before
# ffmpeg is invoked, so the filter may look ahead; filtering forward then backward cancels the
# phase shift exactly. Shot cuts remain hard boundaries in both directions (see
# REFRAME_RESET_ON_CUT). Set false to restore the causal filter.
REFRAME_ZERO_PHASE=true
# V8: how often the follow-active crop position is updated. Was 12, which is visible as
# stepping when the subject moves quickly. This only lengthens the sendcmd script - the
# expensive part of reframe is face sampling, and that rate is REFRAME_SAMPLE_FPS above.
REFRAME_COMMAND_FPS=24
# V16: crop existing letterbox/pillarbox bars before reframing. Source footage is often
# already boxed (a 16:9 export inside a 1:1 frame, a re-upload from another platform), and
# reframing that centres the crop on the bars and bakes them into the vertical output.
AUTO_DELETTERBOX=true

# ---------------------------- Output geometry --------------------------------
# O5/O9: output resolution, named by its short side. Was fixed at the 1080-class values
# with no way to ask for anything else, so a 4K source was always downscaled and a
# low-powered host could not trade quality for encode time. 1080 is the short-form
# consensus. An unrecognised value falls back to 1080 rather than failing the render.
OUTPUT_SHORT_SIDE=1080           # 720 | 1080 | 1440 | 2160

# O7: target one platform's output profile instead of shipping the same file everywhere. Sets
# the resolution, the bitrate ceiling and the clip-length cap for that destination; a clip longer
# than the destination accepts otherwise fails at upload having already cost a full render.
#
# An explicit OUTPUT_SHORT_SIDE or OUTPUT_MAX_BITRATE_KBPS always wins - the profile only fills
# in values you have not chosen. The profile's *aspect* is advisory and is never applied
# silently: re-shaping an explicit 9:16 request into 16:9 because a platform was named would be
# a setting that fights the interface.
#
# Note this selects ONE profile. It does not render a variant per platform: that is N encodes, N
# thumbnails and N publish records per clip - a job-model change, not an encoder setting.
OUTPUT_PLATFORM=                 # tiktok | instagram | youtube | youtube_shorts | x | whop

# O12: how captions are delivered. Burned-in is the right default for short-form -- the feeds
# autoplay muted and nobody enables a subtitle track -- but it is a permanent, untranslatable,
# un-hideable decision baked into the pixels.
#
#   burned  the shipped behaviour: captions rendered into the video
#   soft    a selectable mov_text track instead; the video has no caption pixels
#   both    burned captions AND a soft track
#
# mov_text is plain text, so the preset animation, per-word highlighting, glyphs and positioning
# cannot survive in the soft track. That is a limitation of what MP4 can carry, not of this
# tool, and it is why `both` exists rather than `soft` simply replacing `burned`.
CAPTION_MODE=burned              # burned | soft | both

# O8: optional hardware H.264 encoding.
#   libx264            software (default)
#   auto               use a working hardware encoder if there is one, else libx264
#   h264_nvenc         NVIDIA
#   h264_qsv           Intel Quick Sync
#   h264_videotoolbox  Apple
#   h264_vaapi         Linux VA-API (often needs -vaapi_device, which this project does not set)
#
# Availability is decided by *actually encoding a frame*, not by reading `ffmpeg -encoders`. The
# difference is not hypothetical: the ffmpeg this project develops against lists h264_v4l2m2m and
# fails on the first frame, and h264_nvenc behaves the same way on a host with the libraries but no
# card. Anything unavailable falls back to libx264. A *named* request that falls back records an
# `encoder_unavailable:` marker on the clip, because silently ignoring it is how someone spends a
# week believing their GPU is in use.
#
# The default is libx264, not auto, deliberately: these encoders are not comparable with x264 at
# the same nominal quality - each spells "constant quality" differently and VideoToolbox's scale is
# inverted (1-100, higher better) - so `auto` would change the output of every existing install the
# first time it landed on a machine with a GPU, with no setting changed.
#
# h264_v4l2m2m is deliberately NOT offered: it has no constant-quality mode, only -b:v, so using it
# would quietly switch the pipeline from a quality target to a bitrate target.
VIDEO_ENCODER=libx264

# ---------------------- Sound effects and placement -------------------------
# AU9: a sting on a cut or an emoji. off | emoji | transitions | both.
#
# A cut or an emoji popping in is a visual accent with no audible counterpart, so the edit reads as
# a picture change rather than as a beat.
#
# What is synthesised and what is not is the important part here. 'pop' and 'click' ARE generated,
# honestly: a pop *is* a short band-passed noise burst with a fast attack, so generating one is not
# an approximation of the real thing. 'whoosh' and 'swipe' are NOT generated, because a whoosh is
# noise under a filter that *moves* across the sound and ffmpeg cannot express a time-varying filter
# frequency in a single pass - a static band-passed noise swell is a hiss, and shipping a hiss under
# a name that promises a sweep is exactly the mislabelling A15 recorded for the synthesised music
# bed. Put a file in SFX_DIR for those; without one the sting is skipped and the clip records
# sfx_missing:<name>.
#
# CONSEQUENCE WORTH KNOWING BEFORE YOU SET THIS: the transition trigger maps to 'whoosh', which is
# one of the two that are not synthesised, and assets/sfx/ ships empty. So SFX_MODE=transitions
# produces NO SOUND on a stock install - every hit records sfx_missing:whoosh and the audio is left
# alone. SFX_MODE=emoji works out of the box, because its trigger maps to 'pop'.
#
# Off by default: an audible change to every clip is not something to acquire by upgrading.
SFX_MODE=off
# Sting level relative to full scale. Mixed with `amix normalize=0`, so a sting never lowers the
# speech - with normalisation on, adding one accent would make the whole clip 1/n quieter.
SFX_VOLUME=0.35

# V15: move the caption to another of the nine C13 positions when it would cover a detected face's
# mouth. Off by default for two reasons: it costs a face-detection pass over the clip, which a
# render that never had a collision would be paying for nothing; and it changes placement on the
# clips it does act on.
#
# It only ever acts on an *actual* overlap, and it keeps the horizontal alignment the preset chose -
# answering "bottom-left covers the mouth" with "centre-top" changes two things to fix one. When no
# position clears the face (a close-up filling the frame) it changes nothing and records
# caption_face_overlap_unavoidable, because moving the text from the mouth to the eyes is not an
# improvement.
CAPTION_AVOID_FACES=false

# T10: add an English subtitle *track* rather than letting task=translate replace the captions.
# Whisper's translate task rewrites the transcript in English, which means asking for a
# translation used to cost you the original-language captions -- the clip a Spanish creator
# posts to a Spanish audience came back with English burned into it. With this on, the burned
# captions stay in the source language and English arrives as a second, selectable track plus a
# `.en.srt`/`.en.vtt` sidecar, so one render serves both audiences.
#
# A boolean, not a target language: Whisper only ever translates *to* English (X->en), so a
# `SUBTITLE_TRANSLATION_LANGUAGE=fr` would be a setting that quietly ignores its own value.
#
# It costs a second full ASR pass over the source. That pass is cached separately by T8 (the
# cache key includes the task), so a re-run is free, but the first run roughly doubles the
# transcription time -- hence off by default. Skipped, with a `subtitle_translation:skipped_*`
# marker, when the source is already English or when TRANSLATE was requested for the main pass.
SUBTITLE_TRANSLATION=false

# ------------------------------ Look details ---------------------------------
# V11: what fills the frame around fitted video. This was one hard-coded look (boxblur 40
# plus a slight darkening), which suits talking-head footage and actively hurts other
# things -- a blurred screen recording is an unreadable smear, and gameplay footage becomes
# noise competing with the clip. 'black' is the honest choice for screen recordings;
# 'mirror' reads as intentional where a blur reads as a mistake.
# V23: keep the speaker a similar size across cuts.
#
# A clip cut from a close-up and a wide shot delivers a speaker who changes size at every cut.
# Reframing follows the face's position and says nothing about its size, so the jump survives it.
#
# Face height is measured per shot using the SAME cut list V4 already uses for its tracker reset, then
# magnification steps at cut boundaries only. Never within a shot -- that would be a zoom, and this
# project already has zoom and ken-burns with their own easing.
#
# Two limits worth knowing. It can only ever magnify: the crop is already the largest window of the
# target aspect that fits the source, so a shot whose subject is *bigger* than the target cannot be
# widened and is left alone. And it is bounded to 1.35x, past which the softening is more visible than
# the mismatch it corrects.
#
# It DECLINES when ZOOM or ken-burns is on, recording subject_scale_skipped:zoom_active. The mechanism
# is a magnification, so two of them on one shot multiply into a curve neither feature intended.
#
# OFF by default, and this is the least certain default in its spec: a director may have *chosen* to
# alternate between close and wide, and normalising that removes an intentional edit.
SUBJECT_SCALE_NORMALISE=false

BACKGROUND_STYLE=blur            # blur | mirror | black | color | gradient
BACKGROUND_COLOR=0x0F172A        # used when BACKGROUND_STYLE=color

# V13: the progress bar was a 12px bar in one cyan, always at the bottom -- where on a 9:16
# clip it sits directly under the captions and competes with them. 'track' adds a dim
# full-width rail, so how much is *left* is visible rather than only how much has passed.
PROGRESS_BAR_POSITION=bottom     # bottom | top
PROGRESS_BAR_STYLE=bar           # bar | track
PROGRESS_BAR_COLOR=0x22D3EE
PROGRESS_BAR_THICKNESS=12

# V9: which opening treatment the `transitions` flag applies. punch_in eases from 1.18x and
# reads as a camera move; zoom_cut steps with no easing and reads as an edit; whip_pan slides
# in laterally and decelerates; dissolve fades up from black.
#
# Note there is nowhere in this product for a literal clip-to-clip transition to live: every
# clip is an independent deliverable published separately, and a transition needs two shots
# that meet. These are the treatments of a clip's own opening.
TRANSITION_STYLE=punch_in        # punch_in | zoom_cut | whip_pan | dissolve

# AU4: speech de-noise. Off by default, and conservative when on: over-reduced noise leaves
# speech sounding underwater and gated, which is a worse defect than the room tone it removed.
# A slightly noisy clip is publishable; one that sounds processed is not.
#
# afftdn (spectral gating) is used unless SPEECH_DENOISE_MODEL points at a real arnndn model.
# arnndn is the better filter and IS compiled into ffmpeg, but ffmpeg ships no models -- they
# live in a separate repository -- so it is unavailable unless you supply one. A configured but
# missing model degrades to afftdn rather than failing the render.
SPEECH_DENOISE=off               # off | light | standard | strong
SPEECH_DENOISE_MODEL=            # path to an .rnnn model, e.g. ./assets/models/sh.rnnn

# AU5: de-esser, for sibilance on a harsh or close-miked source. Even "strong" is intensity 0.6,
# not 1.0: at full intensity the 4-8 kHz band loses so much energy that consonants lose
# definition, which is a different defect rather than a fix.
#
# AU5 also asks for de-reverb, and that is NOT implemented: ffmpeg has no de-reverb filter --
# not one this build lacks, one that does not exist upstream. Real de-reverberation needs
# spectral deconvolution or a trained model, i.e. an external dependency. A high-pass plus a
# gate is sometimes sold as "de-reverb"; it is not, and shipping it under that name would be
# worse than not shipping it.
DEESSER=off                      # off | light | standard | strong

# V18: a 3D LUT applied after the colour preset, for a look the five presets cannot express -
# a house grade, or a client's brand LUT, which is nearly always delivered as a .cube. Applied
# after the preset because a LUT maps final values; the reverse would feed its output back
# into a contrast curve. Empty means no LUT, and a missing file is ignored rather than
# failing the render.
COLOR_LUT=

# V19: ease the Ken Burns push instead of ramping it linearly. A constant rate is the one
# thing a camera move never does, and on a long clip the frame visibly creeps. Same start and
# end zoom; only the curve changes.
#
# Off by default, and deliberately so: this changes the rendered pixels, and the convention
# here - the same one TRANSITION_STYLE and the PROGRESS_BAR_* settings follow - is that a new
# visual setting defaults to whatever shipped, so the v0.8.0 byte-parity gate keeps meaning
# something. Turning this on is expected to change your output; that is the point of it.
ZOOM_EASE=false
# V19: bump the scale briefly on detected audio accents. This is onset detection over the
# energy envelope that is already measured for scoring - not beat tracking, so every bump sits
# on a real transient rather than an estimated tempo. Off by default: it suits music-led
# footage and is a distraction on a talking head.
BEAT_SYNC_ZOOM=false
BEAT_SYNC_RISE_DB=6.0            # level jump between readings that counts as an accent

# V17: score a few candidate frames when choosing the thumbnail rather than taking a fixed
# position, which on a clip opening on a cut or a blink picked exactly the wrong still.
# Scored on sharpness (motion blur is the most common way an auto thumbnail looks bad) and
# on mid-range exposure, so a near-black or blown-out frame loses.
# C20: choose the caption's outline (or box) colour from the video behind it.
#
# Every preset carries fixed colours, defaulting to white text with a black outline. That is right
# most of the time and wrong in the two cases that matter: over a bright sky or a white wall the
# black outline is the only thing keeping white glyphs visible and it does that job badly, and over
# dark footage a heavy black outline merges with the background into a shapeless mass. Neither is
# visible in the settings panel -- it shows up in the finished clip, in the one element a viewer is
# guaranteed to look at.
#
# Samples three frames from the region the caption will actually occupy (derived from the same
# position and safe-area maths the renderer uses, so it measures the pixels the text sits on rather
# than the frame average). Three rather than one because a single frame can be a cut or a flash.
#
# It never changes the FILL colour. A preset's fill is a brand decision, and silently recolouring
# it because a shot was bright would overrule the one thing the creator chose -- only the
# legibility layer, which nobody picks on purpose, is adjusted.
CAPTION_AUTO_CONTRAST=false

SMART_THUMBNAIL=true

# V14: a closing call-to-action over the tail of the clip. Clips currently end the instant the
# speech does, which wastes the one moment a viewer has already decided to watch to the end.
#
# Rendered as a libass event, like every other piece of text here, so it survives an ffmpeg
# built without freetype. It fades in and settles upward, and deliberately does NOT fade out -
# the clip ends under it, and fading would take the words away at the decision point.
#
# Empty disables it. The hold is capped at half the clip length, so a 3-second clip does not
# become an advert with a clip attached.
END_CARD_TEXT=
END_CARD_SECONDS=2.0

# ------------------------------ Publishing -----------------------------------
# Persistent clip/publish history (SQLite) and the throttled scheduler.
HISTORY_DB=./storage/history.db
PUBLISH_POLL_SECONDS=2               # how often the scheduler checks for due posts
# A *floor* under each publisher's own rate limit, for operators who want to be
# more conservative than the platforms require. 0 means "trust each publisher"
# (whop 2s, x 5s, tiktok 10s, youtube 15s, instagram 18s). This replaced
# PUBLISH_DEFAULT_INTERVAL_SECONDS, which defaulted to 30 and therefore overrode
# every publisher's declared limit, making them all dead code.
PUBLISH_MIN_INTERVAL_FLOOR_SECONDS=0

# PB5: automatic retry of TRANSIENT publish failures, with exponential backoff and jitter.
#
# A publish attempt used to have exactly one chance: any failure -- an expired token, a 503 from
# TikTok, a DNS hiccup, a rate-limit response -- wrote state=failed and stopped until a human
# pressed Retry. That makes a network blip indistinguishable from a rejected video.
#
# Only failures recognised as transient are retried; the default is NOT to retry. A clip that is
# too long, a caption the platform refused or a revoked permission will fail identically forever,
# and retrying those burns quota while hiding the real problem. Automatic retry also never touches
# a review_required attempt: that is waiting on a person, and re-queueing it would either loop or
# silently escalate a review submission into a live post.
#
# The delay carries proportional jitter (up to 25%), because every attempt failing against the
# same platform outage becomes due at the same instant and would otherwise retry in lockstep.
PUBLISH_MAX_RETRIES=3            # 0 restores the previous single-shot behaviour
PUBLISH_RETRY_BASE_SECONDS=30    # first delay; doubles each retry
PUBLISH_RETRY_MAX_SECONDS=3600   # ceiling on the delay

# PB4: renew an OAuth access token this long before it expires. YouTube is the only publisher
# that can refresh itself -- it is the only one given a refresh token -- and it previously
# exchanged that token on EVERY publish while discarding the expiry Google returns, so nothing in
# the product could say when a credential would stop working. Tokens are now cached with their
# expiry and renewed just ahead of it.
#
# The margin matters because an upload is not instantaneous: a resumable PUT of a 1080p clip takes
# tens of seconds, so a token with five seconds left expires *during* the request it was fetched
# for. Refreshing early costs one cheap token exchange; not doing so costs the whole upload.
#
# TikTok, Instagram and X use long-lived tokens pasted into this file and Whop an API key. None
# can be renewed from here; when they expire a human has to obtain a new one. They report
# token_kind=static so the dashboard can say so rather than implying they never expire.
PUBLISH_TOKEN_REFRESH_MARGIN_SECONDS=300

# PB6: regenerate the description for each destination platform at publish time, instead of
# fitting the copy that already exists.
#
# Metadata is generated once for one platform, then the same text goes everywhere. The
# per-platform limits are real (tiktok 80/300/8, x 70/260/4) but were applied only at generation
# time, so publishers chopped the result at a character index -- cutting mid-word and removing the
# call to action and hashtags, the parts doing the work.
#
# With this OFF (the default) the copy is *fitted*: hashtags beyond the platform's count are
# dropped, and the description is shortened at a sentence boundary, then a clause, then a word,
# with the CTA and tags reserved first. With it ON the description is rewritten for the
# destination by the LLM, which is what the plan asks for and costs one model call per platform
# per clip.
PUBLISH_TAILOR_WITH_LLM=false

# --- Whop (uploads/attachments via the official @whop/sdk Node bridge) -------
# The bridge lives in publisher_bridge/ and requires Node.js + `npm install`
# there (done automatically in the Docker image).
WHOP_API_KEY=
WHOP_COMPANY_ID=                     # optional default company/account (biz_xxx)
WHOP_NODE_BINARY=node                # path to the Node runtime for the bridge

# --- YouTube (Data API v3, OAuth 2.0 refresh-token flow; vertical => Shorts) -
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=                  # optional default channel

# --- TikTok (Content Posting API) --------------------------------------------
# Until your app passes TikTok's audit, uploads land in the user's inbox as a
# draft. Set TIKTOK_DIRECT_POST_APPROVED=true only once Direct Post is approved.
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_DIRECT_POST_APPROVED=false

# --- Instagram (Graph API, Professional account + Facebook Login) ------------
# Requires the instagram_content_publish permission (app review) to publish.
# Without it the adapter runs in review mode only.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_CONTENT_PUBLISH_APPROVED=false

# --- X / Twitter (API v2, OAuth user context) --------------------------------
# X has no API "draft"; posting requires an approved user-context token. Set
# X_DIRECT_POST_APPROVED=true only when your access level permits media posting.
X_ACCESS_TOKEN=
X_ACCOUNT_ID=
X_DIRECT_POST_APPROVED=false
