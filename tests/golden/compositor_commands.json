    "graph": [
      "[0:v]eq=contrast=1.12:saturation=1.35:brightness=0.02,zoompan=z='(1+0.12*on/90)':d=1:fps=30:s=1080x1920:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)'[vlook]",
      "[2:v]scale=540:-1,format=rgba,setpts=PTS-STARTPTS+0.400/TB[bpre0]",
      "[vlook][bpre0]overlay=x='(W-w)/2':y='H*0.12':enable='between(t,0.400,1.400)'[vbroll]",
      "[vbroll]subtitles='<TMP>/base.ass':fontsdir='<REPO>/assets/fonts'[vbase]",
      "[3:v]scale=150:-1,format=rgba,fade=t=in:st=1.700:d=0.18:alpha=1[e0]",
      "[vbase][e0]overlay=x='(W-w)*0.16':y='H*0.15':enable='between(t,1.700,3.000)'[vout]",
      "[1:a]aloop=loop=-1:size=2147483647,atrim=0:3.000,asetpts=N/SR/TB,afade=t=in:st=0:d=0.350,afade=t=out:st=1.800:d=1.200[bedfit]",
      "[bedfit]volume=0.120[bedlvl]",
      "[bedlvl]anull[bedv]",
      "[0:a][bedv]amix=inputs=2:duration=first:normalize=0[aout]",
      "[aout]alimiter=limit=0.8913:level=disabled[apeak]"
