# Refuse to install a dependency whose declared `engines` are not satisfied by the
# running Node, instead of printing an EBADENGINE warning and carrying on.
#
# Without this, `npm install <pkg>@latest` on a newer local Node happily records a
# dependency that CI's Node cannot run. That is exactly what happened: jsdom@30 and
# @testing-library/jest-dom@7 both require Node >=22, were installed on Node 22, and
# broke the Node 20 CI job with `webidl.util.markAsUncloneable is not a function`
# (jsdom@30 -> undici@8, which needs Node >=22.19). npm ci exited 0 with only warnings,
# so the mistake surfaced as a confusing test-run crash rather than an install error.
#
# The floor lives in package.json `engines`; this makes it enforced rather than advisory.
engine-strict=true
